__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.dll
*.egg-info/
.venv/
venv/
.env
.ipynb_checkpoints/

# Leading slash matters: a bare "models/" also matches src/models/, which is
# source code, and silently kept it out of the repository.
/logs/
/run_logs/
/checkpoints/

# Note the trailing /* rather than /. Git does not descend into an ignored
# directory, so a "!" exception for a file inside one never takes effect.
# Ignoring the contents instead leaves the directory itself visible.
/models/*
/outputs/*
# Small enough to keep, and it is the headline result of the whole project.
!/outputs/evaluation_report.json

# Derived from Dataset/ by src/data/preprocessing.py and scripts/generate_masks.py.
# Regenerate rather than commit ~13k files; both take a couple of minutes.
data/processed/
data/masks/
!data/processed/.gitkeep
!data/masks/.gitkeep

# Submission bundles
*.zip

# Working documents kept locally, not published with the project.
# The plan is superseded by the README; the Kaggle notebook was pushed by
# Kaggle's "Save copy to GitHub" and duplicates notebooks/kaggle_train.ipynb.
/brain_tumor_project_plan (1).md
/notebook73b290e23e.ipynb

*.keras
*.h5
*.pth
*.pt
*.onnx

# Exception: the three trained models the Streamlit app loads. Streamlit
# Community Cloud deploys straight from this repository and has no other way to
# obtain them, so they are committed despite the ~147 MB cost. Saved without
# optimizer state, which is why they are a third of their original size.
!/models/detection_model.keras
!/models/classification_model.keras
!/models/best_unet.pth

.DS_Store
Thumbs.db
